                        "text": "Reset Selected",
                        "text_size": 8.0,
                        "text_color": [
                            240,
                            242,
                            245,
                            255
                        ],
                        "action_mode": true,
                        "action_script": "import maya.cmds as cmds\n\n\ndef _reset(nodes):\n    for node in nodes:\n        for attr in cmds.listAttr(node, keyable=True, unlocked=True) or []:\n            plug = \"{}.{}\".format(node, attr)\n            try:\n                default = cmds.attributeQuery(attr, node=node, listDefault=True)\n                if default:\n                    cmds.setAttr(plug, default[0])\n            except Exception:\n                pass\n\n\nif not __INIT__:\n    cmds.undoInfo(openChunk=True)\n    try:\n        _reset(cmds.ls(sl=True) or [])\n    finally:\n        cmds.undoInfo(closeChunk=True)\n"
                    }
                ]
            }
