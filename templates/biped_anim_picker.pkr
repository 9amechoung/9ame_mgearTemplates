                        "action_mode": true,
                        "action_script": "import maya.cmds as cmds\n\nif not __INIT__:\n    ctls = [c for c in __FLATCONTROLS__ if cmds.objExists(c)]\n    if ctls:\n        cmds.setKeyframe(ctls)\n"
