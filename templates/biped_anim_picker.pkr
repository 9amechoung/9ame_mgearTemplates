                        "action_mode": true,
                        "action_script": "import maya.cmds as cmds\n\n\ndef _namespace():\n    # \ud53c\ucee4\uc5d0 \ub124\uc784\uc2a4\ud398\uc774\uc2a4\uac00 \uc9c0\uc815\ub418\uc9c0 \uc54a\uc558\uc73c\uba74 \uc120\ud0dd\ud55c \ub178\ub4dc\uc5d0\uc11c,\n    # \uadf8\ub798\ub3c4 \uc5c6\uc73c\uba74 \uc52c\uc5d0 \ucee8\ud2b8\ub864\ub7ec \uc14b\uc774 \uc788\ub294 \ub124\uc784\uc2a4\ud398\uc774\uc2a4\uac00 \ud558\ub098\ubfd0\uc77c \ub54c \uadf8\uac83\uc744 \uc4f4\ub2e4.\n    if __NAMESPACE__:\n        return __NAMESPACE__\n    sel = cmds.ls(sl=True) or []\n    if sel:\n        ns = sel[0].split(\"|\")[-1].rpartition(\":\")[0]\n        pattern = \"{}:*_controllers_grp\".format(ns) if ns else \"*_controllers_grp\"\n        if cmds.ls(pattern, type=\"objectSet\"):\n            return ns\n    if cmds.ls(\"*_controllers_grp\", type=\"objectSet\"):\n        return \"\"\n    found = sorted(set(\n        s.rpartition(\":\")[0] for s in\n        cmds.ls(\"*:*_controllers_grp\", type=\"objectSet\", recursive=True) or []))\n    if len(found) == 1:\n        return found[0]\n    if len(found) > 1:\n        cmds.warning(\"Anim Picker: several rigs found ({}). Pick the namespace \"\n                     \"in the picker or select a control of the rig first.\"\n                     .format(\", \".join(found)))\n    return \"\"\n\nfrom mgear.anim_picker.handlers import action_handlers\n\n_space_ns = _namespace()\n_space_host = \"{}:spineUI_C0_ctl\".format(_space_ns) if _space_ns else \"spineUI_C0_ctl\"\n# \ub85c\ub4dc \uc2dc(__INIT__)\uc5d0\ub294 \ubc84\ud2bc \uae00\uc790\ub9cc \ud604\uc7ac \uc2a4\ud398\uc774\uc2a4\ub85c \ubc14\uafbc\ub2e4. \ub9ac\uadf8\uc5d0 \ud574\ub2f9\n# UI \ub178\ub4dc/\uc18d\uc131\uc774 \uc5c6\uc73c\uba74 \uc5d0\ub7ec \ub85c\uadf8 \uc5c6\uc774 \uac74\ub108\ub6f4\ub2e4.\nif not __INIT__ or cmds.objExists(_space_host + \".neck_ikref\"):\n    action_handlers.show_space_chage_list(_space_ns,\n                                          \"spineUI_C0_ctl\",\n                                          \"neck_ikref\",\n                                          \"neck_C0_ik_ctl\",\n                                          __SELF__,\n                                          __INIT__)\n"
