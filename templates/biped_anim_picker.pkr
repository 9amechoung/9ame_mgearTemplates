Picker: nothing to mirror\")\n        return\n    # \uac12\uc744 \ubaa8\ub450 \uc77d\uc740 \ub4a4\uc5d0 \uc4f4\ub2e4 (Flip \uc2dc \uc591\ucabd\uc774 \uc11c\ub85c\uc758 \uc6d0\ub798 \uac12\uc744 \ubc1b\ub3c4\ub85d)\n    entries = []\n    nodes = [n for n in dict.fromkeys(nodes)\n             if n.endswith(\"_ctl\") or cmds.objExists(n + \".isCtl\")]\n    for node in nodes:\n        target = _other(node)\n        if not cmds.objExists(target):\n            continue\n        entries.append((target, _channels(node)))\n        if flip and target != node and target not in nodes:\n            entries.append((node, _channels(target)))\n    failed = []\n    keyed = []\n    changed = []\n    cmds.undoInfo(openChunk=True)\n    try:\n        for target, channels in entries:\n            for attr, value in channels:\n                plug = \"{}.{}\".format(target, attr)\n                if not cmds.objExists(plug):\n                    continue\n                try:\n                    before = cmds.getAttr(plug)\n                    result = _set(plug, value)\n                    if result is False:\n                        failed.append(plug)\n                    elif result and abs(before - value) > 1e-6:\n                        changed.append(plug)\n                        if cmds.keyframe(plug, q=True, keyframeCount=True):\n                            keyed.append(plug)\n                except Exception as e:\n                    failed.append(\"{} ({})\".format(plug, e))\n    finally:\n        cmds.undoInfo(closeChunk=True)\n    print(\"Anim Picker mirror: {} controls -> {} targets, {} values changed \"\n          \"({} keyed): {}\".format(\n              len(nodes), len(entries), len(changed), len(keyed),\n              \", \".join(changed[:8])))\n    if failed:\n        cmds.warning(\"Anim Picker: skipped {} connected attributes: {}\"\n                     .format(len(failed), \", \".join(failed[:10])))\n\n\ndef _copy_side(side, parts):\n    # side \ucabd \ucee8\ud2b8\